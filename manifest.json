{
  "manifest_version": 3,
  "name": "MRU Tab Switcher",
  "version": "1.0.0",
  "description": "Arc-style: hold Ctrl, tap Tab to cycle through recently used tabs, release Ctrl to jump.",
  "permissions": ["tabs", "tabGroups", "activeTab", "scripting", "storage", "favicon"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["overlay.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "cycle-tabs": {
      "suggested_key": {
        "default": "Ctrl+Q",
        "mac": "MacCtrl+Q"
      },
      "description": "Cycle through most recently used tabs"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
